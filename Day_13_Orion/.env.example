# Copy this file to .env and fill in your key. Never commit .env.
#
# OPENROUTER_API_KEY  required. One key for every model (GPT, Claude, Gemini).
#                     Create one at https://openrouter.ai/settings/keys and add a
#                     few dollars of credit; a full run of the lessons costs cents.
OPENROUTER_API_KEY=your_openrouter_key

# PARALLEL_API_KEY    optional. Lesson 3's web research uses the Parallel Search
#                     MCP server, which works without a key; a key raises the rate limit.
PARALLEL_API_KEY=
